<section id="research-activity" data-no-i18n>
  <style>
    #research-activity{margin-block:1.5rem;padding:clamp(12px,2.5vw,24px);border:1px solid #33445d;border-radius:16px;background:#101928;color:#e2eaf5;color-scheme:dark}
    #research-activity h2,#research-activity h3,#research-activity h4{color:#f1f6ff;margin:0 0 .6em}
    #research-activity p{margin:.55em 0;color:#b9cbdf}
    #research-activity .ra-controls{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
    #research-activity button{font:inherit;color:#e2eaf5;cursor:pointer;background:#1c2b40;border:1px solid #455d79;border-radius:7px;padding:4px 9px}
    #research-activity button:hover,#research-activity button[aria-pressed=true]{background:#264464;border-color:#88bbf0}
    #research-activity :focus-visible{outline:2px solid #b3d9ff;outline-offset:3px}
    #research-activity .ra-map{width:100%;aspect-ratio:2;position:relative;overflow:hidden;border:1px solid #334f70;border-radius:12px;background:#0b172a}
    #research-activity canvas{width:100%;height:100%;display:block}
    #research-activity [data-kind=paper]{--ra-color:#c8a96b}
    #research-activity [data-kind=trial]{--ra-color:#8da7a1}
    #research-activity [data-kind=news]{--ra-color:#d6c7a7}
    #research-activity [data-kind=industry]{--ra-color:#a99b83}
    #research-activity [data-kind=conference]{--ra-color:#b8aaa2}
    #research-activity .ra-marker{position:absolute;transform:translate(-50%,-50%);display:grid;place-items:center;min-width:23px;height:23px;border:2px solid #0b172a;border-radius:20px;padding:0 4px;background:var(--ra-color,#b2c9de);color:#101928;font-size:11px;font-weight:750}
    #research-activity .ra-dot{display:inline-block;width:.72em;height:.72em;border-radius:50%;margin-inline-end:.5em;background:var(--ra-color,#b2c9de)}
    #research-activity .ra-marker:hover,#research-activity .ra-marker[aria-pressed=true]{z-index:2;border-color:#fff;background:var(--ra-color,#b2c9de)}
    #research-activity .ra-caption{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;margin-top:7px;font-size:.85rem;color:#c3cfe0}
    #research-activity .ra-results{margin-block:12px 18px;padding:12px;border:1px solid #3b5574;border-radius:10px;background:#15233a;scroll-margin-top:12px}
    #research-activity .ra-results ol{padding-inline-start:1.4rem;margin-bottom:0}
    #research-activity .ra-results li+li{margin-top:10px}
    #research-activity a{color:#9addff}
    #research-activity .ra-evidence{font-size:.88rem;overflow-wrap:anywhere}
  </style>
  <h2 data-ra="map">⌖ 研究动态地图</h2>
  <p data-ra="mapNote"></p>
  <div class="ra-controls" aria-label="地图筛选"></div>
  <div class="ra-map">
    <canvas width="960" height="480" aria-hidden="true"></canvas>
    <div class="ra-markers"></div>
  </div>
  <div class="ra-caption"><button class="ra-unknown" type="button"></button><span>Made with Natural Earth</span></div>
  <p class="ra-disabled" hidden></p>
  <p class="ra-deferred" hidden></p>
  <div class="ra-map-results ra-results" hidden></div>
  <noscript>Enable JavaScript to use the map.</noscript>
  <script type="application/json" id="nd-research-data">{{ activity|tojson }}</script>
  <script>
  (() => {
    const root = document.getElementById('research-activity');
    const data = JSON.parse(document.getElementById('nd-research-data').textContent);
    const copies = {
      zh: {map:'⌖ 研究动态地图', mapNote:'点击地点查看定位依据。研究地点、试验站点与末位作者单位分别标注，城市级点位使用城市中心示意。',
        all:'全部', paper:'论文', trial:'临床试验', news:'新闻与政策', industry:'产业', conference:'学术会议', unknown:'未定位', empty:'当前筛选没有定位结果。', noRecords:'本期没有这类条目。',
        original:'原文', site:'登记坐标', city:'城市级示意', country:'国家级示意', journal_unknown:'期刊待补', disabled:'研究动态地图需要配置大模型 API；未启用时不会生成地图。',
        institution:'作者机构', last_author_institution:'末位作者单位', study_site:'研究地点', trial_site:'试验站点', event:'事件发生地', conference_venue:'会议会址', funding_recipient:'获资方所在地', media_outlet:'媒体机构所在地', publisher:'媒体登记', model:'AI 判定', metadata:'来源元数据'},
      en: {map:'⌖ Research activity map', mapNote:'Select a location to see its evidence. Study sites, trial sites and last-author affiliations are labelled separately. City markers are approximate.',
        all:'All',paper:'Papers',trial:'Clinical trials',news:'News and policy',industry:'Industry',conference:'Academic conferences',unknown:'Unlocated',empty:'No mapped records match this filter.',noRecords:'No records of this type in this report.',
        original:'Source',site:'Registry coordinates',city:'City-level marker',country:'Country-level marker',journal_unknown:'Journal unavailable',disabled:'The research map requires an LLM API. It is disabled when no model is configured.',
        institution:'Author affiliation',last_author_institution:'Last-author affiliation',study_site:'Study site',trial_site:'Trial site',event:'Event location',conference_venue:'Conference venue',funding_recipient:'Funding recipient location',media_outlet:'Media outlet location',publisher:'Publisher registry',model:'AI inference',metadata:'Source metadata'},
      ru: {map:'⌖ Карта исследований',mapNote:'Выберите точку, чтобы увидеть источник геоданных. Места исследований, центры испытаний и организации последних авторов подписаны отдельно. Точки городов приблизительны.',
        all:'Все',paper:'Публикации',trial:'Клинические исследования',news:'Новости и политика',industry:'Индустрия',conference:'Научные конференции',unknown:'Без геоданных',empty:'Для этого фильтра нет точек на карте.',noRecords:'В этом отчёте нет записей такого типа.',
        original:'Источник',site:'Координаты из реестра',city:'Приблизительная точка города',country:'Приблизительная точка страны',journal_unknown:'Журнал не указан',disabled:'Карта исследований требует API языковой модели; без неё карта не строится.',
        institution:'Организация авторов',last_author_institution:'Организация последнего автора',study_site:'Место исследования',trial_site:'Центр испытания',event:'Место события',conference_venue:'Место проведения конференции',funding_recipient:'Местоположение получателя средств',media_outlet:'Местоположение медиа',publisher:'Реестр издателя',model:'Вывод ИИ',metadata:'Метаданные источника'}
    };
    const c = copies[document.documentElement.lang] || copies[{{ language|tojson }}] || copies.zh;
    if (!data.enabled) {
      const notice = root.querySelector('.ra-disabled');
      notice.textContent = c.disabled;
      notice.hidden = false;
      for (const selector of ['.ra-controls', '.ra-map', '.ra-caption', '.ra-deferred', '.ra-map-results']) {
        const node = root.querySelector(selector);
        if (node) node.hidden = true;
      }
      return;
    }
    root.querySelectorAll('[data-ra]').forEach(node => {node.textContent = c[node.dataset.ra];});
    document.querySelectorAll('a[href="#research-activity"]').forEach(link => {
      link.textContent = c.map;
      link.hidden = false;
    });
    const kind = id => data.records[id].category || ({policy:'news', funding:'industry', drug:'industry', device:'industry'}[data.records[id].kind] || data.records[id].kind);
    const node = (tag, value) => {
      const element = document.createElement(tag);
      if (value) element.textContent = value;
      return element;
    };
    const control = (label) => {
      const button = node('button', label);
      button.type = 'button';
      return button;
    };
    const dot = type => {
      const element = node('span');
      element.className = 'ra-dot';
      element.dataset.kind = type;
      element.setAttribute('aria-hidden', 'true');
      return element;
    };
    let localeNames;
    try { localeNames = new Intl.DisplayNames([document.documentElement.lang || 'zh'], {type:'region'}); }
    catch (_) {}
    const placeName = place => place.precision === 'country' && localeNames && place.country
      ? localeNames.of(place.country) : place.name;
    function show(panel, label, ids, places = [], moveFocus = true) {
      panel.removeAttribute('role');
      panel.hidden = false;
      const heading = node('h3', label);
      heading.tabIndex = -1;
      panel.replaceChildren(heading);
      if (!ids.length) {panel.append(node('p', c.noRecords)); return;}
      const list = node('ol');
      const byId = new Map();
      for (const place of places) {
        if (!byId.has(place.id)) byId.set(place.id, []);
        byId.get(place.id).push(place);
      }
      for (const id of ids) {
        const record = data.records[id];
        const li = node('li');
        const venue = record.kind === 'paper'
          ? (record.journal || c.journal_unknown)
          : (record.venue || record.source || '');
        const meta = node('p', [c[kind(id)], venue, record.date].filter(Boolean).join(' · '));
        meta.prepend(dot(kind(id)));
        li.append(node('strong', record.title), meta);
        if (record.summary) li.append(node('p', record.summary));
        for (const place of (byId.get(id) || [])) {
          const evidence = node('p', [placeName(place), c[place.role], c[place.precision], c[place.method], place.source, place.evidence].filter(Boolean).join(' · '));
          evidence.className = 'ra-evidence';
          li.append(evidence);
        }
        let url;
        try { url = new URL(record.url); } catch (_) {}
        if (url && ['http:', 'https:'].includes(url.protocol) && !url.username && !url.password) {
          const a = node('a', c.original);
          a.href = url.href;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          li.append(a);
        }
        list.append(li);
      }
      panel.append(list);
      if (moveFocus) heading.focus();
    }
    const canvas = root.querySelector('canvas');
    if (data.land.length && canvas) {
      const map = root.querySelector('.ra-map');
      const ctx = canvas.getContext('2d');
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const markers = root.querySelector('.ra-markers');
      const filters = root.querySelector('.ra-controls');
      const unknown = root.querySelector('.ra-unknown');
      const results = root.querySelector('.ra-map-results');
      function fitCanvas() {
        const rect = map.getBoundingClientRect();
        canvas.width = Math.max(1, Math.round(rect.width * dpr));
        canvas.height = Math.max(1, Math.round(rect.height * dpr));
      }
      function drawLand() {
        const x = lon => (lon + 180) / 360;
        const y = lat => (90 - lat) / 180;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#202326';
        ctx.strokeStyle = '#45474a';
        ctx.lineWidth = Math.max(1, dpr * .7);
        for (const polygon of data.land) {
          ctx.beginPath();
          for (const ring of polygon) {
            ring.forEach(([lon, lat], i) => ctx[i ? 'lineTo' : 'moveTo'](x(lon)*canvas.width, y(lat)*canvas.height));
            ctx.closePath();
          }
          ctx.fill('evenodd');
          ctx.stroke();
        }
      }
      fitCanvas();
      drawLand();
      if (data.deferred.length) {
        const deferred = root.querySelector('.ra-deferred');
        const count = data.deferred.length;
        deferred.textContent = ({
          zh: count + ' 条记录的 AI 定位未完成。',
          en: 'AI geography was incomplete for ' + count + ' records.',
          ru: 'Записей с незавершённой геолокацией ИИ: ' + count + '.'
        })[document.documentElement.lang];
        deferred.hidden = false;
      }
      filters.setAttribute('aria-label', c.map);
      let selected = 'all';
      const x = lon => (lon + 180) / 360;
      const y = lat => (90 - lat) / 180;
      const matches = id => selected === 'all' || kind(id) === selected;
      function drawMarkers() {
        const groups = [];
        const width = map.clientWidth, height = map.clientHeight;
        const inset = (value, size) => Math.max(13, Math.min(size - 13, value * size));
        for (const place of data.places) {
          if (!matches(place.id)) continue;
          const px = inset(x(place.lon), width), py = inset(y(place.lat), height);
          let group = groups.find(entry => Math.hypot(px-entry.x, py-entry.y) < 26);
          if (!group) {group = {x:px,y:py,places:[]}; groups.push(group);}
          group.places.push(place);
        }
        markers.replaceChildren();
        for (const group of groups) {
          const ids = [...new Set(group.places.map(place => place.id))];
          const label = [...new Set(group.places.map(placeName))].join(' · ');
          const button = control(ids.length.toString());
          button.className = 'ra-marker';
          const kinds = new Set(ids.map(kind));
          if (kinds.size === 1) button.dataset.kind = kind(ids[0]);
          button.style.left = group.x + 'px';
          button.style.top = group.y + 'px';
          button.setAttribute('aria-label', label + ' · ' + ids.length);
          button.title = label + ' · ' + ids.length;
          button.addEventListener('click', () => {
            markers.querySelectorAll('[aria-pressed=true]').forEach(marker => marker.setAttribute('aria-pressed','false'));
            button.setAttribute('aria-pressed','true');
            show(results, label, ids, group.places);
          });
          markers.append(button);
        }
        const withoutPlace = data.unknown.filter(matches);
        unknown.textContent = c.unknown + ' (' + withoutPlace.length + ')';
        unknown.disabled = !withoutPlace.length;
        unknown.onclick = () => show(results, c.unknown, withoutPlace);
        if (!groups.length && results.hidden) {
          results.setAttribute('role', 'status');
          results.textContent = c.empty;
          results.hidden = false;
        } else if (groups.length && results.getAttribute('role') === 'status') {
          results.hidden = true;
        }
      }
      const ids = data.order || Object.keys(data.records);
      for (const type of ['all','paper','trial','news','industry','conference']) {
        const categoryIds = ids.filter(id => kind(id) === type);
        const button = control(type === 'all' ? c.all : `${c[type]} (${categoryIds.length})`);
        button.dataset.filter = type;
        if (type !== 'all') button.prepend(dot(type));
        button.setAttribute('aria-pressed', String(type === selected));
        button.addEventListener('click', () => {
          selected = type;
          filters.querySelectorAll('button').forEach(entry => entry.setAttribute('aria-pressed', String(entry === button)));
          results.hidden = true;
          results.removeAttribute('role');
          if (type !== 'all') show(results, c[type], categoryIds, data.places.filter(place => matches(place.id)), false);
          drawMarkers();
        });
        filters.append(button);
      }
      drawMarkers();
      const redraw = () => { fitCanvas(); drawLand(); drawMarkers(); };
      if (typeof ResizeObserver === 'function') new ResizeObserver(redraw).observe(map);
      else window.addEventListener('resize', redraw);
    }
  })();
  </script>
</section>
