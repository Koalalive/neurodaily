{% macro journal_badges(m, cas_label) -%}
  {% if m %}
    {% set if_year = m.get('if_year', m.get('year')) %}
    {% set jcr_year = m.get('jcr_year', m.get('year')) %}
    {% set cas_year = m.get('cas_year', m.get('year')) %}
    {% if m.get('if') is not none %}<span class="tag tj" title="期刊影响因子">{% if if_year %}{{ if_year }} {% endif %}IF {{ m['if'] }}</span>{% endif %}
    {% if m.get('jcr') %}<span class="tag t">{% if jcr_year %}{{ jcr_year }} {% endif %}JCR {{ m['jcr'] }}</span>{% endif %}
    {% if m.get('cas') or m.get('cas_top') %}<span class="tag t">{% if cas_year %}{{ cas_year }} {% endif %}{{ cas_label }}{% if m.get('cas') %} {{ m['cas'] }}{% endif %}{% if m.get('cas_top') and 'top' not in (m.get('cas') or '')|lower %} Top{% endif %}</span>{% endif %}
    {% for index in ['sci', 'ssci'] %}
      {% if m.get(index) is true %}<span class="tag t" title="已收录">{{ index|upper }}</span>
      {% elif m.get(index) is false %}<span class="tag t">{{ index|upper }} <span>未收录</span></span>{% endif %}
    {% endfor %}
    {% for tag in m.get('tags') or [] %}<span class="tag t journal-mark" data-no-i18n>{{ tag }}</span>{% endfor %}
    {% if m.get('if') is none and m.get('oa_2yr') is not none %}<span class="tag t" title="OpenAlex 两年平均被引次数（非 JCR IF）">OA 2yr {{ m['oa_2yr'] }}</span>{% endif %}
  {% endif %}
{%- endmacro %}

{% macro tags_meta(it, badge_class) -%}
<div class="meta">
  <span class="badge {{ badge_class }}">{{ it.kind_label }}</span>
  {% if "top-journal" in it.tags and it.source != "pubmed" and it.source != "arxiv" %}<span class="badge b-journal" data-no-i18n>★ {{ it.source }}</span>{% endif %}
  {% set m = it.extra.get('metrics') or {} %}
  {% set journal_name = m.get('name') or it.extra.get('journal') %}
  {% if journal_name and journal_name != it.source %}<span class="tag tj" data-no-i18n>{{ journal_name }}</span>{% endif %}
  {{ journal_badges(m, {'en': 'CAS', 'ru': 'КАН'}.get(language, '中科院')) }}
  <span class="tag t" data-no-i18n>{{ it.source }}</span>
  {% if it.extra.get('search_match') == 'unknown' %}<span class="tag bad">待确认</span>{% endif %}
  {% if it.date_display %}<span class="tag t">{{ it.date_display }}</span>{% endif %}
  {% if it.doi %}<span class="tag t">doi:{{ it.doi }}</span>{% endif %}
  {% for t in it.tags[:4] if t != "top-journal" %}<span class="tag" data-no-i18n>{{ t }}</span>{% endfor %}
</div>
{%- endmacro %}

{% macro record_links(records, versions=false) -%}
{% for record in records if record is mapping %}
  {% set url = external_url(record.get('url')) %}
  {% set label = record.get('label') or record.get('source') or record.get('title') or record.get('doi') or '记录' %}
  {% if versions %}
    {% set version = {'published': '正式发表', 'preprint': '预印本'}.get(record.get('kind')) %}
    {% if version and not label.startswith(version) %}{% set label = version ~ ' · ' ~ label %}{% endif %}
  {% endif %}
  {% if url %}<a class="ext" href="{{ url }}" target="_blank" rel="noopener noreferrer" data-no-i18n>{{ label }}</a>{% else %}<span data-no-i18n>{{ label }}</span>{% endif %}
  {% if not loop.last %}<span aria-hidden="true"> · </span>{% endif %}
{% endfor %}
{%- endmacro %}

{% macro block_section(key, title, desc, badge_class, entries=None) -%}
{% set items = entries if entries is not none else result.sections.get(key, []) %}
<section id="{{ key }}">
  <div class="sec-head">
    <div>
      <h2 class="sec-title"><span class="dot"></span>{{ title }}
        <span class="count">({{ items|length }})</span></h2>
      <p class="sec-desc">{{ desc }}</p>
      {% if key == 'papers' and sort_label %}<p class="sec-desc">排序 · {{ sort_label }}</p>{% endif %}
    </div>
  </div>
  {% if items %}
    {% for it in items %}
    <details class="card">
      <summary>
        <span class="chevron"></span>
        <div class="card-main">
          <h3 data-no-i18n>{% if external_url(it.url) %}<a href="{{ external_url(it.url) }}" target="_blank" rel="noopener noreferrer">{{ it.title }}</a>{% else %}{{ it.title }}{% endif %}</h3>
          {{ tags_meta(it, badge_class) }}
        </div>
      </summary>
      <div class="card-body">
        {% set rules = it.extra.get('matched_rules') or [] %}
        {% set missing = it.extra.get('missing_fields') or [] %}
        {% if rules or missing %}
          <div class="evidence">
            {% if rules %}
              <b>命中依据</b>
              <ul data-no-i18n>{% for rule in rules %}<li>{{ rule }}</li>{% endfor %}</ul>
            {% endif %}
            {% if missing %}<p><b>无法判断的字段</b> · {{ missing|join('、') }}</p>{% endif %}
          </div>
        {% endif %}
        {% if it.summary %}<p class="summary" data-no-i18n>{{ it.summary }}</p>{% endif %}
        {% if it.author_display %}<div class="byline"><b>Authors:</b> <span data-no-i18n>{{ it.author_display }}</span>{% if it.corresponding_display %} <span class="corr">@ <b>Corresponding authors:</b> <span data-no-i18n>{{ it.corresponding_display }}</span></span>{% endif %}</div>{% endif %}
        {% if it.affiliation_display %}<div class="byline aff"><b>Affiliations:</b> <span data-no-i18n>{{ it.affiliation_display }}</span></div>{% endif %}
        {% if it.extra.get('provenance')|default([], true)|length > 1 %}<div class="byline"><b>合并来源</b> · {{ record_links(it.extra.get('provenance')) }}</div>{% endif %}
        {% if it.extra.get('related_versions') %}<div class="byline"><b>相关版本</b> · {{ record_links(it.extra.get('related_versions'), versions=true) }}</div>{% endif %}
        {% for evidence in it.extra.get('related_evidence', []) %}
          <div class="byline"><b>{{ {'verified': '相关来源', 'reference': '原文引用编号'}.get(evidence.method, '待确认关联') }}</b> · {{ record_links([evidence]) }}</div>
        {% endfor %}
        {% set update_labels = {'correction': '更正', 'retraction': '撤稿', 'withdrawal': '撤回', 'expression-of-concern': '关注声明'} %}
        {% for notice in it.extra.get('publication_updates', []) %}
          <div class="byline"><b>{{ update_labels.get(notice.kind, notice.kind) }}</b> · {{ record_links([{'url': notice.url, 'title': notice.doi}]) }} {{ notice.date }}{% if notice.direction == 'notice_for' %} · <span>涉及论文</span>{% endif %}</div>
        {% endfor %}
        {% set trial_event_labels = {'registered': '首次登记', 'registry_updated': '登记更新', 'results_posted': '结果发布', 'status_changed': '状态变更'} %}
        {% for event in it.extra.get('trial_events', []) %}
          <div class="byline"><b>{{ trial_event_labels.get(event.kind, event.kind) }}</b> · {{ event.date }}{% if event.kind == 'status_changed' %} · {{ event['from'] }} → {{ event.to }}{% endif %}</div>
        {% endfor %}
        <div class="foot">
          {% if external_url(it.url) %} · <a class="ext" href="{{ external_url(it.url) }}" target="_blank" rel="noopener noreferrer">Read ↗</a>{% endif %}
          {% if result.history_id and item_key(it) %}
          <span data-report-record="{{ item_key(it) }}" hidden></span>
          {% endif %}
        </div>
      </div>
    </details>
    {% endfor %}
  {% else %}
    <div class="empty">No items retrieved for this category.</div>
  {% endif %}
</section>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="nd-report-date" content="{{ result.generated_at[:10] }}">
<meta name="nd-report-profile" content="{{ result.config_profile }}">
{% if result.history_id %}<meta name="nd-report-run-id" content="{{ result.history_id }}">{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="nd-base" content="">
<title>NeuroDaily — {{ result.config_profile }} | {{ today }}</title>
<style>
  :root {
    --bg: #000000; --panel: #0d0d0d; --panel2: #141414;
    --accent: #38bdf8; --accent2: #818cf8; --text: #e8e8e8;
    --muted: #8a8a8a; --border: #222222; --ok: #34d399; --warn: #fbbf24;
  }
  * { box-sizing: border-box; }
  body { margin:0; font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
         background: var(--bg); color: var(--text); line-height: 1.55; }
  header { padding: 32px 24px 20px; border-bottom: 1px solid var(--border);
           background: #000000; }
  .wrap { max-width: 1080px; margin: 0 auto; }
  h1 { margin:0; font-size: 1.9rem; letter-spacing:-.01em; }
  h1 .logo { background: linear-gradient(90deg, var(--accent), var(--accent2));
             -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sub { color: var(--muted); margin-top: 6px; font-size: .95rem; }
  .window { color: var(--muted); margin-top: 4px; font-size: .82rem; }
  .window span { color: var(--accent); font-weight: 700; margin-right: 5px; }
  .chips { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { background: var(--panel); border: 1px solid var(--border); border-radius: 999px;
          padding: 4px 12px; font-size: .8rem; color: var(--accent); }
  .stats { display:flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .stat { background: var(--panel); border:1px solid var(--border); border-radius: 12px;
          padding: 10px 16px; min-width: 120px; }
  .stat b { display:block; font-size: 1.4rem; color: var(--accent); }
  .stat span { font-size:.75rem; color: var(--muted); text-transform: uppercase; letter-spacing:.05em; }

  main { padding: 24px; }
  section { margin-bottom: 40px; }
  .sec-head { display:flex; justify-content: space-between; align-items:flex-start; gap:16px; margin-bottom: 4px; }
  .sec-title { font-size: 1.15rem; margin: 0 0 4px; display:flex; align-items:center; gap:10px; }
  .sec-title .dot { width:9px; height:9px; border-radius:50%; background: var(--accent); }
  .sec-title .count { color: var(--muted); font-size:.85rem; font-weight: normal; }
  .sec-desc { color: var(--muted); font-size:.85rem; margin: 0; }
  .sec-actions { display:flex; gap: 6px; flex-shrink: 0; padding-top: 4px; }
  .minibtn { background: var(--panel); color: var(--muted); border:1px solid var(--border);
             border-radius: 8px; font-size:.75rem; padding: 4px 10px; cursor:pointer; transition: color .15s, border-color .15s; }
  .minibtn:hover { color: var(--accent); border-color: var(--accent); }

  /* Collapsible cards */
  .card { background: var(--panel); border:1px solid var(--border); border-radius: 12px;
          margin-bottom: 12px; overflow:hidden; transition: border-color .15s; }
  .card:hover { border-color: var(--accent); }
  .card > summary { list-style: none; cursor: pointer; display:flex; align-items:flex-start;
                    gap: 12px; padding: 14px 18px; user-select: none; }
  .card > summary::-webkit-details-marker { display: none; }
  .card > summary .chevron { flex-shrink: 0; width: 12px; height: 12px; margin-top: 5px;
      border-right: 2px solid var(--accent); border-bottom: 2px solid var(--accent);
      transform: rotate(45deg); transition: transform .2s ease; }
  .card[open] > summary .chevron { transform: rotate(225deg); }
  .card-main { flex: 1; min-width: 0; }
  .card h3 { margin:0 0 6px; font-size:1.02rem; }
  .card h3 a { color: var(--text); text-decoration: none; }
  .card h3 a:hover { color: var(--accent); }
  .meta { display:flex; flex-wrap: wrap; gap: 8px; align-items:center; }
  .badge { font-size:.68rem; padding:2px 8px; border-radius:999px; letter-spacing:.03em;
           text-transform: uppercase; border:1px solid transparent; }
  .b-doc      { background:#0e7490; }
  .b-drug     { background:#7c3aed; }
  .b-device   { background:#0f766e; }
  .b-trial    { background:#b45309; }
  .b-news     { background:#be185d; }
  .b-policy   { background:#1d4ed8; }
  .b-conference{background:#a21caf; }
  .b-journal  { background:#b45309; color:#fff; font-weight:600; }
  .tag { background: var(--panel2); color: var(--accent2); font-size:.72rem;
         padding:2px 8px; border-radius:999px; }
  .tag.t { color: var(--muted); }
  .tag.tj { background:#38260a; color:#fbbf24; border:1px solid #5a3d12; }
  .journal-mark { max-width:100%; overflow-wrap:anywhere; }
  .card-body { padding: 0 18px 14px 42px; }
  .summary { color: var(--muted); font-size:.88rem; margin:0 0 8px; }
  .evidence { margin:0 0 10px; padding:8px 12px; border-left:2px solid var(--accent);
              background:var(--panel2); font-size:.82rem; overflow-wrap:anywhere; }
  .evidence ul { margin:4px 0 0; padding-left:20px; }
  .evidence p { margin:0; }
  .evidence ul + p { margin-top:4px; }
  .byline { font-size:.8rem; color: var(--accent2); margin:0 0 4px; }
  .byline b { color: var(--muted); font-weight:600; }
  .byline.aff { color: var(--muted); }
  .corr { color: var(--warn); font-weight:600; }
  .foot { color: var(--muted); font-size:.75rem; }
  a.ext { color: var(--accent); text-decoration:none; font-size:.82rem; }
  a.ext:hover { text-decoration: underline; }
  .empty { color: var(--muted); padding: 12px; border:1px dashed var(--border); border-radius: 12px; }

  /* Journal grid */
  .journals { display:grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap:12px; }
  .journal { background: var(--panel); border:1px solid var(--border); border-radius:12px;
             padding: 14px 16px; transition: border-color .15s, transform .15s; }
  .journal:hover { border-color: var(--accent); transform: translateY(-1px); }
  .journal h4 { margin:0 0 4px; font-size:.98rem; }
  .journal h4 a { color: var(--text); text-decoration:none; }
  .journal h4 a:hover { color: var(--accent); }
  .journal .cat { color: var(--muted); font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; }

  .health { background: var(--panel); border:1px solid var(--border); border-radius:12px;
            padding:16px; margin-top: 8px; overflow-x:auto; }
  .health table { width:100%; border-collapse:collapse; font-size:.82rem; }
  .health th, .health td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--border); }
  .health th { color: var(--muted); font-weight:600; }
  .health td.source-detail { color:var(--muted); }
  .source-detail p { margin:4px 0; }
  .source-detail code { display:block; white-space:pre-wrap; overflow-wrap:anywhere; }
  .ok { color: var(--ok); } .bad { color: var(--warn); }
  .prompt { background: #0a0a0a; border:1px solid var(--border); border-radius:12px;
            padding:16px; font-family: ui-monospace, "SF Mono", Menlo, monospace;
            font-size:.78rem; white-space:pre-wrap; color:#c8c8c8; }
  footer { text-align:center; color: var(--muted); font-size:.75rem; padding: 24px; border-top:1px solid var(--border); }
  .toolbar { display:flex; gap:10px; margin-top:16px; align-items:center; flex-wrap:wrap; }
  .btn { background: linear-gradient(90deg, var(--accent), var(--accent2)); color:#000000;
         border:none; border-radius:10px; padding:8px 18px; font-size:.88rem; font-weight:600;
         cursor:pointer; text-decoration:none; transition: filter .15s, transform .15s; }
  .btn:hover { filter:brightness(1.12); transform:translateY(-1px); }
  .btn:disabled { opacity:.55; cursor:wait; }
  .btn.ghost { background:transparent; color:var(--accent); border:1px solid var(--accent);
               font-weight:500; }
  .runmsg { font-size:.8rem; color:var(--muted); }
  .runmsg.ok { color:var(--ok); }
  @media (max-width: 640px) { .sec-head { flex-direction: column; } }
  html{scroll-behavior:smooth}
  section[id]{scroll-margin-top:84px}
  .toc{position:fixed;right:16px;top:96px;width:172px;padding:10px 10px 12px;
       background:rgba(20,20,22,.94);border:1px solid #262626;border-radius:12px;
       z-index:60;backdrop-filter:blur(10px);font-size:12.5px;line-height:1.2}
  .toc .toc-title{font-weight:700;color:#e8e8e8;margin:2px 6px 8px;font-size:11px;
       letter-spacing:.10em;text-transform:uppercase}
  .toc a{display:block;color:#9a9a9a;text-decoration:none;padding:6px 8px;border-radius:7px}
  .toc a:hover{color:#fff;background:#1e1e20}
  .toc a[hidden]{display:none}
  @media (max-width:1280px){
    .toc{left:12px;right:12px;bottom:12px;top:auto;width:auto;display:flex;gap:2px;
         overflow-x:auto;padding:8px;border-radius:12px}
    .toc .toc-title{display:none}
    .toc a{white-space:nowrap;padding:6px 10px}
  }

  .sec-toggle{margin-left:8px}
  h2.sec-title + .sec-toggle{display:inline-block;vertical-align:middle;margin:0 0 10px 10px}
  .sec-body[hidden]{display:none}

html { color-scheme: dark; scrollbar-color: #3a4352 #0b0b0c; scrollbar-width: thin; }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: #0b0b0c; }
::-webkit-scrollbar-thumb { background: #3a4352; border: 2px solid #0b0b0c; border-radius: 999px; }
::-webkit-scrollbar-thumb:hover { background: #58647a; }

/* ------------------------------------------------------------------
   Editorial report skin
   One restrained accent, serif display type, hairline lists.
   ------------------------------------------------------------------ */
body.editorial {
  --bg: #090a0c; --panel: #0e1013; --panel2: #121419;
  --accent: #c8a96b; --accent2: #8da7a1;
  --text: #ece9e2; --muted: #979791; --border: rgba(255,255,255,.10);
  --ok: #83b59f; --warn: #c6a46b;
  --serif: "Source Serif 4", "Iowan Old Style", "Noto Serif CJK SC", "Songti SC", Georgia, serif;
  --sans: var(--serif);
  background: var(--bg); color: var(--text); font-family: var(--sans);
  font-size: 15px; line-height: 1.7; letter-spacing: .001em;
}
body.editorial .wrap { max-width: 1020px; }
body.editorial header.masthead {
  padding: 58px 24px 30px; border-bottom: 1px solid var(--border);
  background: radial-gradient(70% 80% at 15% 0%, #17171a 0%, transparent 70%), var(--bg);
}
body.editorial .masthead-kicker {
  margin-bottom: 18px; color: var(--accent); font: 600 10px/1.2 var(--sans);
  letter-spacing: .18em;
}
body.editorial .masthead-kicker span { color: #5d5b56; margin: 0 5px; }
body.editorial h1, body.editorial .sec-title, body.editorial .journal h4,
body.editorial .card h3 { font-family: var(--serif); font-weight: 600; }
body.editorial h1 { font-size: clamp(2.25rem, 5vw, 4.8rem); line-height: 1.04; letter-spacing: -.035em; overflow-wrap: anywhere; }
body.editorial h1 span { max-width: 100%; }
body.editorial h1 .logo { color: var(--text); background: none; -webkit-text-fill-color: currentColor; }
body.editorial h1 .title-sep { color: var(--accent); font-weight: 400; }
body.editorial h1 span:last-child { color: #b9b4a7; font-size: .58em; letter-spacing: -.01em; }
body.editorial .sub, body.editorial .window { color: var(--muted); font-size: .82rem; }
body.editorial .sub { margin-top: 14px; }
body.editorial .window span { color: var(--accent); font-weight: 600; }
body.editorial .chips { gap: 7px 16px; margin-top: 17px; }
body.editorial .chip {
  background: none; border: 0; border-bottom: 1px solid #383832;
  border-radius: 0; padding: 0 0 2px; color: var(--muted); font-size: .72rem;
  letter-spacing: .02em;
}
body.editorial .stats {
  display: flex; gap: 0; margin-top: 30px; border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border); width: 100%;
}
body.editorial .stat {
  background: none; border: 0; border-radius: 0; padding: 13px 24px 12px 0;
  min-width: 0; flex: 1;
}
body.editorial .stat + .stat { border-left: 1px solid var(--border); padding-left: 24px; }
body.editorial .stat b { color: var(--text); font: 500 1.55rem/1.1 var(--serif); }
body.editorial .stat span { color: var(--muted); font-size: .63rem; letter-spacing: .12em; }
body.editorial .toolbar { margin-top: 18px; gap: 16px; }
body.editorial .task-context { color: #77756e; font-size: .74rem; letter-spacing: .02em; }
body.editorial .btn {
  background: var(--accent); color: #15120b; border-radius: 3px; padding: 7px 14px;
  font-size: .78rem; font-weight: 700; letter-spacing: .01em;
}
body.editorial .btn:hover { filter: none; background: #ddc183; transform: none; }
body.editorial .btn.ghost { background: transparent; color: #c8c2b4; border: 0; border-bottom: 1px solid #5c5a52; border-radius: 0; padding: 2px 0 3px; }
body.editorial .btn.ghost:hover { color: var(--accent); border-color: var(--accent); }
body.editorial main.wrap { padding: 42px 24px 70px; }
body.editorial section { margin-bottom: 56px; }
body.editorial .sec-head { margin-bottom: 18px; }
body.editorial .sec-title {
  gap: 13px; margin: 0 0 7px; font-size: clamp(1.55rem, 2.5vw, 2.15rem);
  line-height: 1.12; letter-spacing: -.025em;
}
body.editorial .sec-title .dot { width: 22px; height: 1px; border-radius: 0; background: var(--accent); }
body.editorial .sec-title .count { color: #77756e; font: 400 .62em/1 var(--sans); letter-spacing: .04em; }
body.editorial .sec-desc { color: #85837d; font-size: .78rem; }
body.editorial .card {
  background: transparent; border: 0; border-top: 1px solid var(--border);
  border-radius: 0; margin: 0; overflow: visible;
}
body.editorial .card:last-child { border-bottom: 1px solid var(--border); }
body.editorial .card:hover { border-color: var(--border); }
body.editorial .card > summary { padding: 20px 0 17px; gap: 17px; }
body.editorial .card > summary::before {
  counter-increment: report-item; content: counter(report-item, decimal-leading-zero);
  flex: 0 0 25px; padding-top: 4px; color: var(--accent); font: 500 .65rem/1 var(--sans);
  letter-spacing: .08em;
}
body.editorial section { counter-reset: report-item; }
body.editorial .card > summary .chevron { width: 7px; height: 7px; margin-top: 9px; border-width: 1px; border-color: #77756e; }
body.editorial .card h3 { font-size: clamp(1.05rem, 1.8vw, 1.34rem); line-height: 1.35; letter-spacing: -.012em; }
body.editorial .card h3 a { color: var(--text); }
body.editorial .card h3 a:hover { color: var(--accent); }
body.editorial .meta { gap: 8px 15px; margin-top: 8px; }
body.editorial .badge {
  background: none; border: 0; border-radius: 0; padding: 0; color: var(--accent2);
  font: 500 .61rem/1.2 var(--sans); letter-spacing: .10em;
}
body.editorial .badge.b-journal { color: var(--accent); }
body.editorial .tag {
  background: none; border: 0; border-radius: 0; padding: 0; color: #77756e;
  font: .67rem/1.35 var(--sans);
}
body.editorial .tag.tj { color: #b4a988; }
body.editorial .tag.t { color: #77756e; }
body.editorial .tag.bad { color: var(--warn); }
body.editorial .card-body { padding: 0 0 22px 42px; }
body.editorial .summary { color: #aaa8a0; font-size: .9rem; line-height: 1.8; max-width: 75ch; }
body.editorial .evidence { background: #0d0f12; border-left: 1px solid var(--accent); padding: 9px 14px; }
body.editorial .byline { color: var(--accent2); font-size: .76rem; }
body.editorial .byline b { color: #77756e; }
body.editorial .byline.aff { color: #77756e; }
body.editorial .foot { margin-top: 10px; }
body.editorial a.ext { color: var(--accent); font-size: .76rem; }
body.editorial .empty { border-color: var(--border); border-radius: 0; background: none; }
body.editorial #ai-summary { margin-bottom: 62px; }
body.editorial #ai-summary .card {
  border: 0; border-top: 1px solid var(--accent); border-bottom: 1px solid var(--border);
  padding: 23px 0 25px !important; background: none;
}
body.editorial #ai-summary .card-body { padding: 0 0 0 42px !important; }
body.editorial #ai-summary .card-body p { color: #c3c0b7; font: 400 1.08rem/1.9 var(--serif); max-width: 72ch; }
body.editorial #ai-summary .card-body p + p { margin-top: 1em; }
body.editorial .journals { gap: 0; border-top: 1px solid var(--border); }
body.editorial .journal {
  background: none; border: 0; border-bottom: 1px solid var(--border); border-radius: 0;
  padding: 16px 18px 16px 0;
}
body.editorial .journal:hover { border-color: var(--border); transform: none; }
body.editorial .journal .cat { color: #77756e; font-size: .63rem; letter-spacing: .12em; }
body.editorial .journal h4 { font-size: 1.02rem; }
body.editorial .health { background: none; border: 0; border-top: 1px solid var(--border); border-radius: 0; padding: 0; }
body.editorial .health th, body.editorial .health td { border-bottom-color: rgba(255,255,255,.07); }
body.editorial .health th { color: #77756e; font-size: .68rem; letter-spacing: .08em; }
body.editorial .ok { color: var(--ok); } body.editorial .bad { color: var(--warn); }
body.editorial .prompt { background: #0d0f12; border-color: var(--border); border-radius: 2px; }
body.editorial .toc {
  position: fixed; left: 12px; right: 12px; bottom: 12px; top: auto; width: auto;
  display: flex; gap: 2px; padding: 8px; overflow-x: auto;
  background: rgba(14,16,19,.94); border: 1px solid var(--border); border-radius: 2px;
  z-index: 60; backdrop-filter: blur(10px); font-size: 12.5px; line-height: 1.2;
}
body.editorial .toc .toc-title { display: none; }
body.editorial .toc a { display: block; white-space: nowrap; color: #979791; padding: 6px 10px; border-radius: 0; font-size: .78rem; }
body.editorial .toc a:hover { color: var(--accent); background: #15140f; }
body.editorial footer { border-top-color: var(--border); color: #77756e; }
body.editorial .minibtn { background: none; border-color: var(--border); border-radius: 2px; color: #77756e; }
@media (max-width: 640px) {
  body.editorial header.masthead { padding: 38px 18px 24px; }
  body.editorial main.wrap { padding: 30px 18px 56px; }
  body.editorial .stats { flex-wrap: wrap; }
  body.editorial .stat { flex: 1 1 33%; border-left: 0 !important; padding-left: 0 !important; min-width: 0; }
  body.editorial .stat span { overflow-wrap: anywhere; }
  body.editorial .ra-controls { max-width: 100%; }
  body.editorial #research-activity, body.editorial #research-activity .ra-map { max-width: 100%; }
  body.editorial .card > summary { padding: 16px 0 14px; gap: 10px; }
  body.editorial .card > summary::before { flex-basis: 18px; }
  body.editorial .card-body { padding-left: 28px; }
  body.editorial #ai-summary .card-body { padding-left: 28px !important; }
}
/* Final responsive and map restraint pass */
html { overflow-x: hidden; }
body.editorial { overflow-x: hidden; }
body.editorial .toc { max-width: calc(100vw - 24px); }
body.editorial h1, body.editorial .masthead-kicker, body.editorial .sub, body.editorial .window { max-width: 100%; overflow-wrap: anywhere; }
@media (max-width: 640px) {
  body.editorial .wrap { width: 100%; }
  body.editorial .toc a { flex: 0 0 auto; }
}
/* Keep the research map in the report's quiet palette instead of its own blue dashboard skin. */
body.editorial #research-activity,
body.editorial #topic-map {
  border-color: var(--border); border-radius: 2px; background: transparent; color: var(--text);
}
body.editorial #research-activity h2,
body.editorial #research-activity h3,
body.editorial #research-activity h4,
body.editorial #topic-map h2,
body.editorial #topic-map h3,
body.editorial #topic-map h4 { color: var(--text); }
body.editorial #research-activity p,
body.editorial #topic-map p { color: var(--muted); }
body.editorial #research-activity .ra-map,
body.editorial #topic-map .tm-canvas {
  border-color: var(--border); border-radius: 1px; background: #0d0f12;
}
body.editorial #research-activity button,
body.editorial #topic-map button {
  background: transparent; color: var(--muted); border-color: var(--border); border-radius: 1px;
}
body.editorial #research-activity button:hover,
body.editorial #research-activity button[aria-pressed=true],
body.editorial #topic-map button:hover,
body.editorial #topic-map button[aria-pressed=true] {
  color: var(--accent); border-color: var(--accent); background: #15140f;
}
body.editorial #research-activity .ra-caption { color: var(--muted); }
body.editorial #research-activity .ra-results,
body.editorial #topic-map .tm-side {
  background: #0d0f12; border-color: var(--border); border-radius: 1px;
}
body.editorial #research-activity a,
body.editorial #topic-map a { color: var(--accent); }

/* Editorial preview: all text uses the serif family. */
body.editorial,
body.editorial button,
body.editorial input,
body.editorial select,
body.editorial textarea,
body.editorial code,
body.editorial pre,
body.editorial kbd,
body.editorial samp,
body.editorial .masthead-kicker,
body.editorial .sub,
body.editorial .window,
body.editorial .chip,
body.editorial .stat span,
body.editorial .sec-desc,
body.editorial .badge,
body.editorial .tag,
body.editorial .byline,
body.editorial .foot,
body.editorial .toc,
body.editorial .toc a,
body.editorial .prompt {
  font-family: var(--serif);
}
</style>
</head>
<body class="editorial">
{% set categories = result.report_categories() %}
{% set category_labels = {
  'zh': {'paper': '论文', 'trial': '临床试验', 'news': '新闻与政策', 'industry': '产业', 'conference': '学术会议'},
  'en': {'paper': 'Papers', 'trial': 'Clinical trials', 'news': 'News and policy', 'industry': 'Industry', 'conference': 'Academic conferences'},
  'ru': {'paper': 'Публикации', 'trial': 'Клинические исследования', 'news': 'Новости и политика', 'industry': 'Индустрия', 'conference': 'Научные конференции'}
} %}
{% set category_labels = category_labels.get(language, category_labels['zh']) %}
{% set ui_labels = {
  'zh': {'window':'检索时间窗','trials':'◉ 临床试验','trials_desc':'新增或更新的临床研究。','conferences':'▦ 学术会议','conferences_desc':'即将召开的会议、截止日期与官网链接。','trials_stat':'试验','conf_stat':'会议'},
  'en': {'window':'Search window','trials':'◉ Clinical Trials','trials_desc':'New or updated clinical studies.','conferences':'▦ Academic Conferences','conferences_desc':'Upcoming conferences, deadlines and official links.','trials_stat':'Trials','conf_stat':'Conferences'},
  'ru': {'window':'Окно поиска','trials':'◉ Клинические испытания','trials_desc':'Новые или обновлённые клинические исследования.','conferences':'▦ Академические конференции','conferences_desc':'Ближайшие конференции, дедлайны и официальные ссылки.','trials_stat':'Испытания','conf_stat':'Конференции'}
}.get(language, {}) %}
<div id="top"></div>
<nav class="toc" aria-label="目录">
  <div class="toc-title">目录</div>
  <a href="#top">↑ 顶部</a>
  {% if result.ai_summary %}<a href="#ai-summary">✦ AI 摘要</a>{% endif %}
  <a href="#research-activity" hidden>⌖ 研究动态地图</a>
  <a href="#topic-map" hidden>◌ 主题景观</a>
  {% if result.on_this_day %}<a href="#on-this-day">◷ 历史上的今天</a>{% endif %}
  <a href="#papers">▤ 最新论文</a>
  <a href="#industry">◇ 产业与融资</a>
  <a href="#trials">◉ 临床试验</a>
  <a href="#conferences">▦ 学术会议</a>
  <a href="#policy">⌂ 政策与新闻</a>
  {% if result.config and result.config.journals %}<a href="#journals">▥ 期刊</a>{% endif %}
  {% if result.health %}<a href="#source-health">◍ 来源状态</a>{% endif %}
</nav>
<header class="masthead">
  <div class="wrap">
    <div class="masthead-kicker">NEURODAILY <span>/</span> DAILY BRIEF <span>·</span> {{ today }}</div>
    <h1><span class="logo">NeuroDaily</span> <span class="title-sep">·</span> <span>{{ digest_title }}</span></h1>
    <div class="sub"><span>Auto-aggregated</span> {{ today }} · <span>Profile</span>: <span data-no-i18n>{{ result.config_profile }}</span></div>
    {% if result.search_window %}
    <div class="window"><span>{{ ui_labels.get('window', '检索时间窗') }}</span> {{ result.search_window.start }} → {{ result.search_window.end }} · {{ result.search_window.hours }}h · {{ result.search_window.mode }}</div>
    {% endif %}
    {% if result.config %}
    <div class="chips">
      {% for d in result.config.active_disciplines() %}<span class="chip" data-no-i18n>{{ d.name }}</span>{% endfor %}
    </div>
    {% endif %}
    <div class="stats">
      <div class="stat"><b>{{ result.items|length }}</b><span>Items</span></div>
      {% for category, entries in categories.items() %}
      <div class="stat" data-category="{{ category }}"><b>{{ entries|length }}</b><span data-no-i18n>{{ category_labels[category] }}</span></div>
      {% endfor %}
    </div>
    <div class="toolbar">
      <button class="btn" id="runNow" type="button">▸ 检索</button>
      <a class="btn ghost" id="histLink" href="/history">历史</a>
      {% if result.task_name %}<span class="task-context" data-no-i18n>{{ result.task_name }}</span>{% endif %}
    </div>
  </div>
</header>

<main class="wrap">
  {% if result.delta %}{% include "report_delta.html.j2" %}{% endif %}
  {{ block_section('papers', '▤ Latest Papers', 'New PubMed, arXiv, and bioRxiv preprints matching your focus.', 'b-doc') }}
  {{ block_section('industry', '◇ Commercial & Regulatory Progress', 'Drug approvals, device clearances, and funding records.', 'b-drug') }}
  {% set trial_items = categories['trial'] %}
  {% set conference_items = categories['conference'] %}
  {{ block_section('trials', ui_labels.get('trials', '◉ Clinical Trials'), ui_labels.get('trials_desc', 'New + updated clinical studies.'), 'b-trial', trial_items) }}
  {{ block_section('conferences', ui_labels.get('conferences', '▦ Academic Conferences'), ui_labels.get('conferences_desc', 'Upcoming conferences, deadlines and official links.'), 'b-conference', conference_items) }}
  {{ block_section('policy', '⌂ News and policy', 'Institutional press, agency announcements, and news.', 'b-policy') }}

  {% if result.config and result.config.journals %}
  <section id="journals">
    <h2 class="sec-title"><span class="dot"></span>Top Journals
      <span class="count">({{ result.config.journals|length }})</span></h2>
    <p class="sec-desc"><span>Curated watch-list of leading journals — click to browse each site.</span>
      <span>期刊指标优先采用当前配置的录入值。</span>
      <code>OA 2yr</code>: <span>OpenAlex 两年平均被引次数（非 JCR IF）</span></p>
    <div class="journals">
      {% for j in result.config.journals %}
      <div class="journal">
        <div class="cat" data-no-i18n>{{ j.category }}</div>
        <h4 data-no-i18n>{% if external_url(j.url) %}<a href="{{ external_url(j.url) }}" target="_blank" rel="noopener noreferrer">{{ j.name }}</a>{% else %}{{ j.name }}{% endif %}</h4>
        {% set m = jm(j.name) %}
        {% if m %}<div class="meta" style="margin-top:6px">{{ journal_badges(m, {'en': 'CAS', 'ru': 'КАН'}.get(language, '中科院分区')) }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if result.health %}
  <section id="source-health">
    <h2 class="sec-title"><span class="dot"></span>◍ Source Health</h2>
    {% set state_labels = {'ok': '正常', 'empty': '无命中', 'partial': '部分覆盖', 'timeout': '超时', 'limited': '限流', 'failed': '抓取失败', 'disabled': '已停用'} %}
    {% set coverage_labels = {'full': '已按设置完成抓取', 'sampled': '样本范围内的结果', 'partial': '仅覆盖部分请求'} %}
    <div class="health" role="region" aria-label="各来源检索状态" tabindex="0">
      <table>
        <thead><tr><th>来源</th><th>状态</th><th>候选</th><th>已抓取</th><th>命中</th><th>耗时</th></tr></thead>
        <tbody>
        {% for h in result.health %}
          {% set state = h.get('status') or ('ok' if h.get('ok') else 'failed') %}
          {% set candidates = h.get('candidate_count', h.get('candidates')) %}
          {% set queries = h.get('queries') or ([h.query] if h.get('query') else []) %}
          <tr>
            <td data-no-i18n>{{ h.source }}</td>
            <td><span class="{{ 'ok' if state == 'ok' else 'bad' if state in ('failed', 'timeout', 'limited', 'partial') else 't' }}">{{ state_labels.get(state, state) }}</span></td>
            <td>{{ candidates if candidates is not none else '—' }}</td>
            <td>{{ h.get('fetched') if h.get('fetched') is not none else '—' }}</td>
            <td>{{ h.get('count', '—') }}</td>
            <td>{{ h.ms }} ms</td>
          </tr>
          {% if queries or h.get('coverage') or h.get('error') or h.get('truncated') or h.get('unknown') or h.get('lookback_days') %}
            <tr><td colspan="6" class="source-detail">
              {% if h.get('coverage') %}<p>{{ coverage_labels.get(h.coverage, h.coverage) }}</p>{% endif %}
              {% if h.get('truncated') %}<p>已到达抓取上限。</p>{% endif %}
              {% if h.get('unknown') %}<p data-i18n="{count} 条因字段不足待确认。" data-i18n-count="{{ h.unknown }}">{{ h.unknown }} 条因字段不足待确认。</p>{% endif %}
              {% if h.get('lookback_days') %}<p data-i18n="请求回溯 · {count} 天" data-i18n-count="{{ h.lookback_days }}">请求回溯 · {{ h.lookback_days }} 天</p>{% endif %}
              {% if h.get('error') %}<p>{{ h.error }}</p>{% endif %}
                </td></tr>
          {% endif %}
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  {% if result.config %}
  <section id="prompt">
    <h2 class="sec-title"><span class="dot"></span>Structured Focus Prompt</h2>
    <div class="prompt" data-no-i18n>{{ result.config.to_prompt() }}</div>
  </section>
  {% endif %}

  {% if result.errors %}
  <section>
    <h2 class="sec-title"><span class="dot"></span>Warnings</h2>
    <div class="empty">
      {% for e in result.errors %}<div>! {{ e }}</div>{% endfor %}
    </div>
  </section>
  {% endif %}
</main>

<script>
// In file:// mode (report opened directly from disk) the FastAPI routes don't
// exist, so remap History -> sibling history.html and Focus prompt -> the inline
// prompt section; Run now can't work without a server, so show a hint.
var IS_FILE = (location.protocol === 'file:');
if (IS_FILE) {
  var histLink = document.getElementById('histLink');
  if (histLink) histLink.href = 'history.html';
  var settingsLink = document.getElementById('settingsLink');
  var ndMeta = document.querySelector('meta[name="nd-base"]');
  var ND_BASE = (ndMeta && ndMeta.content) ? ndMeta.content.replace(/\/$/, '') : 'http://127.0.0.1:8031';
  if (settingsLink) settingsLink.href = ND_BASE + '/settings';

  window.gotoServer = async function(path){
    var base = ND_BASE;
    try {
      await fetch(base + '/api/status', {cache: 'no-store'});
      location.href = base + path;
    } catch (e) {
      alert((window.ndT||String)('服务未启动：请双击 scripts/启动 NeuroDaily.command，或运行 scripts/start.sh'));
    }
  };
  if (settingsLink) settingsLink.addEventListener('click', function(e){
    e.preventDefault(); window.gotoServer('/settings');
  });
}



var runBtn = document.getElementById('runNow');
var reportTask = document.querySelector('[data-task][data-revision]');
if (runBtn) {
  runBtn.addEventListener('click', function () {
    if (IS_FILE) { window.gotoServer('/run'); return; }
    location.href = '/run';
  });
    if (!IS_FILE) {
    runBtn.disabled = true;
    var runStatusPending = false;
    async function refreshRunButton() {
      if (document.hidden || runStatusPending) return;
      runStatusPending = true;
      try {
        var response = await fetch('/api/search/status', {cache: 'no-store'});
        if (!response.ok) return;
        var run = (await response.json()).search;
        var busy = !!run && run.status === 'running';
        runBtn.disabled = busy;
        var t = window.ndT || String;
        runBtn.textContent = t(busy ? 'Running…' : '▸ Run now');
        if (window.parent === window && run && reportTask && run.id === Number(reportTask.dataset.task) &&
            run.report_revision > Number(reportTask.dataset.revision)) location.reload();
      } catch (e) { /* Retain the last known state during a short interruption. */ }
      finally { runStatusPending = false; }
    }
    refreshRunButton();
    setInterval(refreshRunButton, 2000);
    document.addEventListener('visibilitychange', refreshRunButton);
  }
}
</script>

<footer><span>Generated automatically by NeuroDaily</span> · {{ result.generated_at }}</footer>
<script>
// Make every top-level section collapsible (AI summary, papers, trials, ...).
(function initCollapsibleSections(){
  function toggleButton(body, btn){
    var hide = !body.hidden;
    body.hidden = hide;
    btn.textContent = hide ? 'Expand' : 'Collapse';
    btn.setAttribute('aria-expanded', hide ? 'false' : 'true');
  }
  document.querySelectorAll('main.wrap > section, main > section').forEach(function(sec){
    if (sec.dataset.collapsible) return;
    var head = sec.querySelector(':scope > .sec-head');
    var h2 = sec.querySelector(':scope > h2.sec-title');
    var anchor = head || h2;
    if (!anchor) return;
    var body = document.createElement('div');
    body.className = 'sec-body';
    var node = anchor.nextSibling;
    while (node) { var next = node.nextSibling; body.appendChild(node); node = next; }
    sec.appendChild(body);
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'minibtn sec-toggle';
    btn.textContent = 'Collapse';
    btn.setAttribute('aria-expanded', 'true');
    btn.addEventListener('click', function(){ toggleButton(body, btn); });
    var actions = head && head.querySelector('.sec-actions');
    if (actions) actions.insertBefore(btn, actions.firstChild);
    else if (head) head.appendChild(btn);
    else { btn.style.marginLeft = '10px'; h2.insertAdjacentElement('afterend', btn); }
    sec.dataset.collapsible = '1';
  });
  document.querySelectorAll('.toc a[href^="#"]').forEach(function(a){
    a.addEventListener('click', function(){
      var t = document.querySelector(a.getAttribute('href'));
      if (!t) return;
      var body = t.querySelector(':scope > .sec-body');
      if (body && body.hidden) {
        body.hidden = false;
        var b = t.querySelector('.sec-toggle');
        if (b) { b.textContent = 'Collapse'; b.setAttribute('aria-expanded', 'true'); }
      }
    });
  });
})();
</script>
</body>
</html>
