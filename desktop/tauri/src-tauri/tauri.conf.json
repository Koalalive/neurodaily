{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeuroDaily",
  "version": "1.0.11",
  "identifier": "com.neurodaily.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "神通寰宇 · NeuroDaily",
        "create": false,
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "minimizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; frame-src 'self' http://127.0.0.1:*; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "licenses/NeuroDaily-LICENSE.txt",
      "../../../NOTICE": "licenses/NeuroDaily-NOTICE.txt"
    },
    "shortDescription": "Neuroscience daily digest",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp"
      },
      "wix": {
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "longDescription": "NeuroDaily aggregates neuroscience, psychiatry and oncology literature, trials, funding and policy news into a daily report with AI overview.",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/neurodaily-server"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMzhDMzcxNTM2ODc5QTMKUldTamVXaFRjY000Z01DUmdUWWFSTXdIT1dheXI1MENxVTNrN3NkYkxWMmtTTVc1UEh5cFRqRisK",
      "requireSignedVersion": true
    }
  }
}
