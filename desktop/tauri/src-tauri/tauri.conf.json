{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeuroDaily",
  "version": "1.0.1",
  "identifier": "com.neurodaily.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NeuroDaily",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Neuroscience daily digest",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "longDescription": "NeuroDaily aggregates neuroscience, psychiatry and oncology literature, trials, funding and policy news into a daily report with AI overview.",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/neurodaily-server"
    ]
  }
}
